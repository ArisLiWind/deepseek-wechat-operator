{
  "name": "dsh-plugin-deepseek-wechat-operator",
  "version": "0.1.0",
  "description": "A publishable dsh plugin that turns accessible WeChat content into an agent-operated inbox, digest, and action layer.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/ArisLiWind/deepseek-wechat-operator",
  "bugs": {
    "url": "https://github.com/ArisLiWind/deepseek-wechat-operator/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArisLiWind/deepseek-wechat-operator.git"
  },
  "bin": {
    "deepseek-wechat-operator-bridge": "./src/bridge-server.js"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "wechat",
    "agent",
    "operator"
  ],
  "files": [
    "src/**/*.js",
    "assets/**/*",
    "web/**/*",
    "examples/**/*",
    "docs/**/*",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.js",
    "./bridge": "./src/bridge-service.js",
    "./normalize": "./src/normalize.js",
    "./domain": "./src/domain.js",
    "./fixtures": "./src/fixtures.js",
    "./policy": "./src/policy.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test",
    "demo:json": "node ./src/demo.js",
    "bridge:dev": "node ./src/bridge-server.js",
    "demo:e2e": "node ./src/e2e-demo.js",
    "perf:demo": "node ./src/perf-demo.js",
    "pack:check": "npm pack --dry-run",
    "check": "node --test && node ./src/demo.js && node ./src/e2e-demo.js && node ./src/perf-demo.js && npm pack --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  }
}
